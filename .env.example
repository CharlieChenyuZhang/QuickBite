# Development proxy target. Keep requests same-origin to use Spring session cookies.
API_PROXY_TARGET=http://localhost:8080
# Optional API origin/prefix override. Default is /api.
VITE_API_BASE_URL=/api
# Spring Security default. Override only for an existing customized logout path.
VITE_LOGOUT_PATH=/logout
# Enable sample restaurants and local orders explicitly, never for production.
VITE_DEMO_MODE=false
